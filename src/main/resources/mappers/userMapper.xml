<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
<mapper namespace = "com.jinanging.thebuild.user.repository.UserRepository"> 

	<select id ="selectUser" parameterType = "map"
	resultType = "com.jinanging.thebuild.user.domain.User">
		SELECT 
			`id`
			, `loginId`
			, `password`
			, `nickName`
			, `email`
			, `createdAt`
			, `updatedAt`
		FROM
			`user`
		WHERE
			`loginId` = #{loginId} 
			AND `password` = #{password}
		
		
	</select>

	<insert id = "insertUser" parameterType = "map">
		INSERT INTO
			`user`
		(
			`loginId`
			, `password`
			, `nickName`
			, `email`
			, `introduce`
		)
		VALUE
		(
			#{loginId}
			, #{password}
			, #{nickName}
			, #{email}
			, #{introduce}
		)
	
	</insert>
	
	<select id = "selectCountByLoginId" parameterType = "string"
		resultType = "int">
		
		SELECT
			count(*)
		FROM
			`user`
		WHERE
			`loginId` = #{loginId}
	
	</select>
	
	

</mapper>